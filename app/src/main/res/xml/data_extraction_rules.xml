<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The Room database contains API credentials, webhook secrets, and SMS data. -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Do not transfer the sensitive Room database to another device. -->
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>